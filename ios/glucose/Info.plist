<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<!--
	개발용 백엔드가 로컬 네트워크(Mac LAN IP)에서 평문 HTTP로 떠 있어서 ATS 예외가 필요하다.
	NSAllowsLocalNetworking은 RFC 1918 사설 IP(10.x, 172.16-31.x, 192.168.x)와 .local 도메인에만
	적용되고, 운영 API_BASE_URL(https, 공인 도메인)에는 영향 없다. 공인 IP/도메인에 http://로
	직접 붙는 건 이 예외로도 안 풀리고, 그렇게 하면 안 된다(토큰이 인터넷 구간에 평문 노출).
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<!-- 한국어 앱: Sign in with Apple 버튼 같은 시스템 문구를 한국어로 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- 홈 화면에 보이는 앱 이름. 타깃·저장소 이름(glucose)은 그대로 둔다 -->
	<key>CFBundleDisplayName</key>
	<string>Glubee</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- 위젯·단축어가 여는 주소: glubee://capture, glubee://insulin (App/DeepLinkRouter.swift) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.glubee.glubee</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glubee</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Pretendard (SIL OFL 1.1, Resources/Fonts/Pretendard-OFL.txt). 글꼴 이름은 "Pretendard Variable" -->
	<key>UIAppFonts</key>
	<array>
		<string>PretendardVariable.ttf</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>식사·저혈당 처치 사진을 찍으려면 카메라 접근이 필요합니다.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
